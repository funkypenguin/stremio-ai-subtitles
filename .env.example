# Address the server listens on
HOST=127.0.0.1
PORT=7311
# Public HTTPS address (no trailing slash)
PUBLIC_URL=https://subtitles.example.com
# Encrypts each user's config inside the install link. At least 32 chars: openssl rand -hex 32
# Changing it breaks every existing install.
CONFIG_SECRET=
# Header with the real client IP set by your proxy (x-real-ip for nginx, cf-connecting-ip for Cloudflare).
# Required behind a reverse proxy, and the proxy must OVERWRITE this header (not append to it),
# otherwise users can fake their IP. Without it, every user shares the proxy's IP and one rate limit.
REAL_IP_HEADER=x-real-ip
# Only for headers proxies append to (x-forwarded-for): how many proxies are in front of the app
REAL_IP_HOPS=1
# Set to false to turn off the custom provider (any OpenAI-compatible URL)
ALLOW_CUSTOM_PROVIDER=true
# Limits (optional)
CACHE_TTL_HOURS=24
CACHE_MAX_MB=2000
JOBS_PER_IP_HOUR=30
MAX_JOBS=10
REQS_PER_IP_MIN=60
UPSTREAM_PER_MIN=120
