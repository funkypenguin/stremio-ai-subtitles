# Address the server listens on
HOST=127.0.0.1
PORT=7311
# Public HTTPS address (no trailing slash)
PUBLIC_URL=https://subtitles.example.com
# Encrypts each user's config inside the install link. At least 32 chars: openssl rand -hex 32
# Changing it breaks every existing install.
CONFIG_SECRET=
# Header with the real client IP set by your proxy (x-real-ip for nginx, cf-connecting-ip for Cloudflare)
REAL_IP_HEADER=x-real-ip
# Limits (optional)
CACHE_MAX_MB=2000
CACHE_MAX_DAYS=60
JOBS_PER_IP_HOUR=30
MAX_JOBS=10
